# --- Hanzo ID (white-label login portal) -----------------------------------
#
# All hostname → tenant resolution is driven by env / catalog, never by a
# hardcoded source map. See `lib/config.ts::resolveTenant` and
# ~/work/hanzo/iam/docs/CONVENTION.md for the canonical rules.
#
# Local dev quickstart:
#   cp .env.example .env
#   pnpm install && pnpm dev
# Then sign in at http://localhost:3000/login with admin/root / OTP 999999.
# ---------------------------------------------------------------------------

# 1. SINGLE-TENANT DEPLOY ----------------------------------------------------
#    The simplest mode: one deployment serves one tenant. Set these and you
#    are done. (For multi-host deploys, see section 2 below.)

# IAM backend origin. Defaults to http://localhost:8000 when the request
# hostname looks local, otherwise https://iam.hanzo.ai.
IAM_URL=http://localhost:8000

# Optional: pinned OIDC issuer claim for JWT validation. Defaults to IAM_URL.
# IAM_ISSUER=http://localhost:8000

# Tenant org slug (JWT `owner` claim).
IAM_ORG=hanzo

# Default OAuth client_id (when the request has no ?client_id= query param).
# Convention is `<org>-<app>` — e.g. `hanzo-id`, `lux-id`, `liquidity-id`.
IAM_CLIENT_ID=hanzo-id

# Optional: IAM application name override. Defaults to IAM_CLIENT_ID.
# IAM_APP_NAME=hanzo-id

# Optional: canonical public origin of this deployment (used by OIDC
# discovery doc rewrites). Defaults to `https://<request-host>`.
# PUBLIC_ORIGIN=https://hanzo.id

# 2. MULTI-TENANT (HOST-AWARE) DEPLOY ---------------------------------------
#    One deployment serves N tenants, routed by request hostname. Provide a
#    JSON catalog mapping each host to its tenant overrides. Same shape as
#    `lib/config.ts::TenantConfig` (every field is optional — anything you
#    omit falls back to the section-1 env vars above).
#
# IAM_TENANT_CONFIG_JSON='{
#   "hanzo.id":       { "orgId": "hanzo", "clientId": "hanzo-id" },
#   "lux.id":         { "orgId": "lux",   "clientId": "lux-id" },
#   "zoo.id":         { "orgId": "zoo",   "clientId": "zoo-id" },
#   "pars.id":        { "orgId": "pars",  "clientId": "pars-id" },
#   "id.hanzo.ai":    { "orgId": "hanzo", "clientId": "hanzo-id" }
# }'
#
# Or point at a file (Node runtime only — edge runtimes ignore this):
# IAM_TENANT_CONFIG_PATH=/etc/hanzo-id/tenants.json

# 3. CLIENT-SECRET (server-side OAuth bridge) --------------------------------
#    Only needed by `/api/auth/bridge` when IAM requires client_secret for
#    the authorization_code grant. Pull from KMS in prod, never check in.
# IAM_CLIENT_SECRET=

# 4. RUNTIME /config.json (SPA mode) ----------------------------------------
#    When this Next.js app is fronted by the `ghcr.io/hanzoai/spa` v1.1+
#    image, the SPA fetches /config.json at boot and `lib/config.ts::
#    loadBrowserConfig()` reads it. Use `SPA_*` env vars on the container,
#    NOT `NEXT_PUBLIC_*` (build-time injection). The SPA image renders
#    /config.json from `SPA_*` at pod startup. See
#    ~/work/hanzo/iam/docs/CONVENTION.md §6.
