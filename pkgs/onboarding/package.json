{
  "name": "@hanzo/id-onboarding",
  "version": "0.1.8",
  "description": "Post-login onboarding for the Hanzo ID portal: org → optional project → optional wallet → data-sharing consent → plan. Resumes from the account. White-labeled by host. Domain / service / UI split.",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./service": "./src/service/onboarding.ts",
    "./flow": "./src/ui/OnboardingFlow.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "tc": "tsc --noEmit"
  },
  "dependencies": {
    "@hanzo/id-shared": "workspace:*",
    "@hanzo/iam": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.2.8",
    "react-dom": ">=19.2.8"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
