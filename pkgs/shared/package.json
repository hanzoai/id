{
  "name": "@hanzo/id-shared",
  "version": "0.1.0",
  "description": "Shared types + tenant resolver for the Hanzo ID portal. No UI deps.",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./src/index.ts",
